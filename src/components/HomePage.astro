---
/**
 * Home (the pillar): the all-in-one calculator first (state, pay, what happened), then the folded answer, the map
 * of the 51 jurisdictions as a ledger (top weekly unemployment amount and the leave programs of each), the prose,
 * and the paid leave programs side by side. Text: src/content/home.ts. Generated blocks carry data-chrome.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Clamp from './Clamp.astro';
import Tool from './Tool.astro';
import Body from './Body.astro';
import { HOME, VALUE } from '../content/home';
import { route } from '../i18n/routes';
import { helpers, SOURCES } from '../lib/helpers';
import { pageOfState, pageOfProgram } from '../lib/pages';
import { KIT as K } from '../lib/kit';
import { faqSchema, organizationSchema, websiteSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { LAST_UPDATED } from '../data/site-config';
const lang = 'en';
const x = HOME;
const path = route('home', lang);
const h = helpers();
const sources = x.sources.map((k) => ({ name: SOURCES[k].label, url: SOURCES[k].url }));
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webPageSchema({ name: x.h1, description: x.description, path, lang }), webApplicationSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(x.faqs, lang)];
const states = K.STATES.map((s) => ({ s, page: pageOfState(s.code), progs: K.inState(s.code) }));
const paying = K.PROGRAMS.filter((p) => p.status === 'paying');
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={x.faqs} sources={sources}>
  <header class="mb-4">
    <h1 class="font-serif text-[1.75rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">{x.h1}</h1>
    <p class="mt-2 text-base text-navy-700 sm:text-lg">{x.intro}</p>
  </header>
  <div data-outil data-chrome><Tool kind="all" idPrefix="home" /></div>
  <p class="mt-3 text-sm text-navy-600">{K.STATES.length} unemployment formulas and {paying.length} paid leave and disability programs, 2026 caps · <a href={route('method', lang)} class="underline">How the estimates are built</a> · <a href={route('about', lang)} class="underline">Who publishes this</a> · updated <time datetime={LAST_UPDATED}>{K.day(LAST_UPDATED)}</time></p>
  <p class="mt-3 text-navy-800">{VALUE}</p>
  <Clamp text={x.resume} lang={lang} id="clamp-home" class="my-8" />
  <section data-chrome class="mt-8">
    <h2 class="font-serif text-2xl font-bold text-navy-900">The 51 jurisdictions at a glance</h2>
    <p class="mt-2 text-sm text-navy-700">Top weekly unemployment benefit in 2026 and the state programs that pay during a leave. Highlighted names open the state's page.</p>
    <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-1 text-sm sm:grid-cols-3 lg:grid-cols-4">
      {states.map(({ s, page, progs }) => (
        <li class="flex min-w-0 items-baseline justify-between gap-2 border-b border-navy-100 py-1.5">
          <span class="min-w-0 break-words">{page ? <a href={route(page.id, lang)} class="font-medium text-accent-700 underline-offset-2 hover:underline">{s.name}</a> : s.name}{progs.length > 0 && <span class="ml-1 text-xs text-navy-600">· {progs.filter((p) => p.status === 'paying').map((p) => p.short).join(', ') || 'leave to come'}</span>}</span>
          <span class="tabular-nums shrink-0 text-navy-900">{K.usd(s.max)}</span>
        </li>
      ))}
    </ul>
  </section>
  <section class="mt-8"><Body html={x.why(h)} path={path} /></section>
  <section data-chrome class="mt-10">
    <h2 class="font-serif text-2xl font-bold text-navy-900">Paid leave and disability programs paying in 2026</h2>
    <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {paying.map((p) => { const pp = pageOfProgram(p.id); return (
        <li class="rounded-lg border border-navy-200 bg-white p-4">
          <p class="text-sm font-semibold text-navy-700">{pp ? <a href={route(pp.id, lang)} class="text-accent-700 underline-offset-2 hover:underline">{p.name}</a> : p.name}</p>
          <p class="ledger-figure mt-1">{K.cents(p.max ?? 0)}</p>
          <p class="ledger-range text-sm">top weekly benefit · {Math.max(...Object.values(p.weeks))} weeks at most</p>
        </li>
      ); })}
    </ul>
  </section>
</PageLayout>
